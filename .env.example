# ---------------------------------------------------------------------------
# Environment / secrets only.
#
# Thresholds, windows, weights, lexicons and the source register live in
# config/*.yaml and config/lexicons/*.json - they are data, not deployment
# settings (spec 20). Values here override the YAML overlay.
# ---------------------------------------------------------------------------

# --- Database & storage ----------------------------------------------------
# Matches the docker-compose service (host port 55432 avoids clashing with a
# local PostgreSQL on 5432).
DATABASE_URL=postgresql+asyncpg://ecd:ecd_dev_password@localhost:55432/ecd
REDIS_URL=redis://localhost:56379/0
REDIS_ENABLED=false
OBJECT_STORE_PATH=./data/raw_evidence

# Optional S3-compatible object store for compressed raw evidence.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Source credentials ----------------------------------------------------
# A collector whose credential is absent starts DISABLED rather than failing at
# request time (spec 20). Grant least privilege: the GitHub token needs only
# public read.
GITHUB_TOKEN=
BRAVE_API_KEY=
X_API_TOKEN=
NEYNAR_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
COINGECKO_API_KEY=

# --- Alerting --------------------------------------------------------------
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key
TIMEZONE_DISPLAY=Africa/Lagos
STORAGE_TIMEZONE=UTC

# Comma-separated origins allowed to call the analyst API. Never use "*": the
# API is credentialed and internal.
CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

# --- Kill switches ---------------------------------------------------------
# Disables all outbound read-only RPC verification during an incident.
VERIFIER_ENABLED=true
# Human approval is required before any outreach leaves the system (spec 22).
HUMAN_APPROVAL_BEFORE_OUTREACH=true
