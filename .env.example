# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./data/chains.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blockchain_finder
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_PATH=./data/raw_evidence
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API Keys & Source Credentials (Modules start in disabled mode if keys are absent)
GITHUB_TOKEN=
BRAVE_API_KEY=
X_API_TOKEN=
NEYNAR_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
COINGECKO_API_KEY=

# Alerting & Webhooks
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key
TIMEZONE_DISPLAY=Africa/Lagos
